# =================================
# Qt 构建系统和编译输出
# =================================

# Qt Creator 构建目录
build-*/
*-build-*/
Debug/
Release/
x64/
x86/
*.autosave

# 编译中间文件
*.o
*.obj
*.patch
*.res
*.pdb
*.idb
*.ilk
*.exp
*.lib
*.a

# Qt 元对象编译器输出
moc_*
qrc_*
ui_*
*.moc
*.rcc
*.qrc.d
*.ui.h

# =================================
# 可执行文件和库文件
# =================================

# 可执行文件（根据你的项目调整名称）
client_window
system_controller
basic_tester
cycle_controller
*.exe
*.app
*.dll
*.so
*.so.*
*.dylib
*.dylib.*

# =================================
# IDE 和编辑器文件
# =================================

# Qt Creator
*.user
*.user.*
*.pro.user
.qtcreator/
*.autosave

# VS Code
.vscode/
!.vscode/settings.json.example
!.vscode/tasks.json.example
!.vscode/launch.json.example

# CLion
.idea/
cmake-build-*/
*.iws

# Vim
*.swp
*.swo
*.un~

