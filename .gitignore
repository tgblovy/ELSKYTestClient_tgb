# Linux
*~
.directory

# =================================
# 项目特定文件（根据你的项目结构调整）
# =================================

# 核心模块可能生成的临时文件
core/core_*.tmp
core/*.log

# 对话框可能生成的缓存
dialogs/*.cache

# 通用模块的临时文件
common/*.tmp

# 自动启动管理器的临时配置
auto_start_*.tmp

# 设备管理器的缓存文件
device_manager_*.cache
*.device_cache

# 日志文件（保留日志配置，但忽略生成的日志）
*.log
logs/
!logger.h
!logger.cpp

# =================================
# 依赖和第三方库
# =================================

# 第三方库目录
3rdparty/
libs/
external/

# 包管理文件
conanfile.txt
conan.lock
vcpkg.json

# =================================
# 配置和缓存文件
# =================================

# 本地配置文件
*.local
*.config
config.local.ini
settings.local.ini

# 缓存文件
.cache/
*.cache

# 临时文件
*.tmp
*.temp
tmp/

